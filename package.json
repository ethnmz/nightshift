{
  "name": "nightshift",
  "version": "0.1.0",
  "private": true,
  "description": "Overnight, hands-off multi-agent builder for 4-person hackathon teams",
  "type": "module",
  "bin": {
    "nightshift": "bin/nightshift.mjs"
  },
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:dashboard": "npm --workspace dashboard run build",
    "nightshift": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "picomatch": "^4.0.7",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
